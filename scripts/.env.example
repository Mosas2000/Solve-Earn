# Environment Variables for Mainnet Testing

# Your Stacks private key (NEVER commit this file to git!)
# Get this from your Hiro or Leather wallet
STACKS_PRIVATE_KEY=your_private_key_here

# Optional: Custom RPC endpoint
# STACKS_API_URL=https://api.mainnet.hiro.so

# ---------------------------------------------------------------------------
# Batch Transaction Runner
#
# Add up to 10 wallet private keys (hex format). Each wallet will send
# 30 random transactions across the deployed contracts.
#
# Each wallet needs enough STX to cover fees (~0.009 STX) plus any
# bounty pool deposits (~1-4 STX depending on random plan).
# Recommended: ~5 STX per wallet minimum.
# ---------------------------------------------------------------------------
WALLET_KEY_1=
WALLET_KEY_2=
WALLET_KEY_3=
WALLET_KEY_4=
WALLET_KEY_5=
WALLET_KEY_6=
WALLET_KEY_7=
WALLET_KEY_8=
WALLET_KEY_9=
WALLET_KEY_10=
