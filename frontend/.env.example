# ---------------------------------------------------------------------------
# Stacks network configuration
# ---------------------------------------------------------------------------
# Copy this file to .env and adjust values for your environment.
#
# VITE_STACKS_NETWORK
#   Which Stacks network to connect to.
#   Allowed values: mainnet | testnet | devnet
#   Default: testnet
#
VITE_STACKS_NETWORK=testnet

# VITE_CONTRACT_ADDRESS
#   Override the contract deployer address. When omitted the app will
#   use a sensible default for the selected network:
#     mainnet -> SP31PKQVQZVZCK3FM3NH67CGD6G1FMR17VQVS2W5T
#     testnet -> ST31PKQVQZVZCK3FM3NH67CGD6G1FMR17VQZ99B2BP
#     devnet  -> ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM
#
# VITE_CONTRACT_ADDRESS=
